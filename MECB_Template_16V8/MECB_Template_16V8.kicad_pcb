		(rev "1.2")
		(company "DigicoolThings.com")
		(comment 1 "For Minimalist Europe Card Bus (MECB).")
		(comment 2 "U1 PLD positioning provides for ZIF socket space, with DIP20 ZIF friendly footprint.")
